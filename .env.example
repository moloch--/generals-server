# Copy this file to .env and replace the example host paths and public address.
GENERALS_PUBLIC_HOST=online.example.net
GENERALS_DATA_DIR=/home/your-user/generals-data
GENERALS_TLS_DIR=/home/your-user/generals-server-deploy/tls

# Publish the admin listener only on this host Tailscale IPv4 address. Use the
# output of: tailscale ip -4
GENERALS_ADMIN_HOST=100.64.0.1
GENERALS_ADMIN_TOKEN_FILE=/home/your-user/generals-server-deploy/admin-token

# Run the container as the owner of the two bind-mounted host directories.
# On Linux, obtain these values with: id -u; id -g
GENERALS_UID=1000
GENERALS_GID=1000

# Certificate renewal settings. The name must match the Certbot lineage.
GENERALS_CERTIFICATE_NAME=online-example-net
GENERALS_ACME_VOLUME=generals-server-letsencrypt
GENERALS_CERTBOT_IMAGE=certbot/certbot:v5.4.0

# The defaults are suitable when compose.yaml remains in the source checkout.
GENERALS_IMAGE=generals-server:local
GENERALS_BUILD_CONTEXT=.

#!/usr/bin/env bash
set -euo pipefail

exec > >(tee -a /var/log/generals-bootstrap.log | logger -t generals-bootstrap -s 2>/dev/console) 2>&1

decode_file() {
  local encoded=$1
  local destination=$2
  local mode=$3
  printf '%s' "$encoded" | base64 --decode >"$destination"
  chmod "$mode" "$destination"
}

retry() {
  local attempts=$1
  shift
  local _
  for _ in $(seq 1 "$attempts"); do
    if "$@"; then
      return 0
    fi
    sleep 5
  done
  return 1
}

install -d -m 0700 -o root -g root /etc/generals-server
install -d -m 0755 -o root -g root /opt/generals-server
install -d -m 0755 -o root -g root /usr/local/lib/docker/cli-plugins
install -d -m 0755 -o root -g root /etc/systemd/system/docker.service.d
install -d -m 0700 -o root -g root /root/.docker

decode_file '${host_config_b64}' /etc/generals-server/host.conf 0600
decode_file '${compose_b64}' /opt/generals-server/compose.yaml 0644
decode_file '${find_device_b64}' /usr/local/sbin/generals-find-data-device 0755
decode_file '${verify_mount_b64}' /usr/local/sbin/generals-verify-data-mount 0755
decode_file '${block_imds_b64}' /usr/local/sbin/generals-block-container-imds 0755
decode_file '${materialize_token_b64}' /usr/local/sbin/generals-materialize-token 0755
decode_file '${copy_certificate_b64}' /usr/local/sbin/generals-copy-certificate 0755
decode_file '${ensure_certificate_b64}' /usr/local/sbin/generals-ensure-certificate 0755
decode_file '${readiness_b64}' /usr/local/sbin/generals-readiness 0755
decode_file '${deploy_b64}' /usr/local/sbin/generals-deploy 0755
decode_file '${server_service_b64}' /etc/systemd/system/generals-server.service 0644
decode_file '${deploy_service_b64}' /etc/systemd/system/generals-deploy.service 0644
decode_file '${deploy_timer_b64}' /etc/systemd/system/generals-deploy.timer 0644
decode_file '${renew_service_b64}' /etc/systemd/system/generals-cert-renew.service 0644
decode_file '${renew_timer_b64}' /etc/systemd/system/generals-cert-renew.timer 0644
decode_file '${docker_dropin_b64}' /etc/systemd/system/docker.service.d/generals-data.conf 0644
decode_file '${docker_config_b64}' /root/.docker/config.json 0600

# The instance receives its public route through the EIP shortly after launch.
retry 60 curl --fail --silent --show-error --max-time 5 https://checkip.amazonaws.com/ >/dev/null
retry 12 dnf install -y \
  amazon-ecr-credential-helper \
  certbot \
  docker \
  iptables-nft \
  openssl \
  python3-certbot-dns-route53 \
  xfsprogs

for command_name in aws certbot docker iptables mkfs.xfs openssl xfs_growfs; do
  command -v "$command_name" >/dev/null
done

compose_temporary=$(mktemp /usr/local/lib/docker/cli-plugins/.docker-compose.XXXXXX)
trap 'rm -f "$compose_temporary"' EXIT
retry 12 curl --fail --location --silent --show-error \
  --output "$compose_temporary" \
  '${compose_download_url}'
printf '%s  %s\n' '${compose_sha256}' "$compose_temporary" | sha256sum --check --status
chmod 0755 "$compose_temporary"
mv -f "$compose_temporary" /usr/local/lib/docker/cli-plugins/docker-compose
trap - EXIT
docker compose version

systemctl disable --now docker.service docker.socket 2>/dev/null || true

data_device=
for _ in $(seq 1 180); do
  if data_device=$(/usr/local/sbin/generals-find-data-device); then
    break
  fi
  sleep 2
done
if [[ -z "$data_device" ]]; then
  echo "retained EBS volume did not appear within six minutes" >&2
  exit 1
fi

partition_count=$(lsblk --noheadings --output TYPE "$data_device" | awk '$1 == "part" { count++ } END { print count + 0 }')
if (( partition_count != 0 )); then
  echo "retained EBS volume unexpectedly contains partitions" >&2
  exit 1
fi

filesystem_type=$(lsblk --nodeps --noheadings --output FSTYPE "$data_device" | tr -d '[:space:]')
if [[ -z "$filesystem_type" ]]; then
  signatures=$(wipefs --noheadings --output TYPE "$data_device" | tr -d '[:space:]')
  if [[ -n "$signatures" ]]; then
    echo "refusing to format an EBS volume with an unrecognized signature" >&2
    exit 1
  fi
  mkfs.xfs -L generalsdata "$data_device"
elif [[ "$filesystem_type" != xfs ]]; then
  echo "retained EBS volume must contain XFS, found $filesystem_type" >&2
  exit 1
fi

data_uuid=$(blkid -s UUID -o value "$data_device")
[[ -n "$data_uuid" ]]
printf '%s\n' "$data_uuid" >/etc/generals-server/data-volume-uuid
chmod 0600 /etc/generals-server/data-volume-uuid

install -d -m 0755 -o root -g root /srv/generals
awk '$2 != "/srv/generals" { print }' /etc/fstab >/etc/fstab.generals-new
printf 'UUID=%s /srv/generals xfs defaults,nofail,x-systemd.device-timeout=180s,nodev,nosuid,noexec 0 2\n' "$data_uuid" >>/etc/fstab.generals-new
mv -f /etc/fstab.generals-new /etc/fstab
mountpoint --quiet /srv/generals || mount /srv/generals

install -d -m 0700 -o 65532 -g 65532 /srv/generals/data /srv/generals/tls
install -d -m 0700 -o root -g root /srv/generals/letsencrypt /srv/generals/letsencrypt-work
install -d -m 0755 -o root -g root /var/log/letsencrypt
/usr/local/sbin/generals-verify-data-mount

systemctl daemon-reload
systemctl enable --now amazon-ssm-agent.service
systemctl enable --now docker.service
systemctl enable generals-server.service generals-deploy.timer generals-cert-renew.timer
systemctl start generals-deploy.timer generals-cert-renew.timer

touch /var/lib/generals-bootstrap-ready
if ! systemctl start generals-deploy.service; then
  echo "initial deployment is pending; generals-deploy.timer will retry" >&2
fi
